	column IsPast =
			//Tạo cột phụ, tính ngày bán hàng đến thời điểm hiện tại, trả về kết quả True/False, để khi dùng tính LY, PM sẽ trả về thời gian tương ứng cùng kỳ, không hiển thị dư
			Var LastSaleDate = Max (Fact_Product_Sale[Order Date])
			Var LastSaleDatePY = EDATE(LastSaleDate,-12)
			RETURN
			Dim_Date[Date] <= LastSaleDatePY
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 8bd765b0-e6d6-47d5-8902-243d9b6d6537
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column WeekNum = YEAR(Dim_Date[Date])&"-W"&FORMAT(WEEKNUM(Dim_Date[Date],1),"00")

	column 'Date (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('Dim_Date'[Date]),
				"(Blank)",
				'Dim_Date'[Date] IN {DATE(2023, 1, 1),
					DATE(2023, 2, 2),
					DATE(2023, 3, 3),
					DATE(2023, 4, 4),
					DATE(2023, 5, 5),
					DATE(2023, 6, 6),
					DATE(2023, 7, 7),
					DATE(2023, 8, 8),
					DATE(2023, 9, 9),
					DATE(2023, 10, 10),
					DATE(2023, 11, 11),
					DATE(2023, 12, 12),
					DATE(2024, 1, 1),
					DATE(2024, 2, 2),
					DATE(2024, 3, 3),
					DATE(2024, 4, 4),
					DATE(2024, 5, 5),
					DATE(2024, 6, 6),
					DATE(2024, 7, 7),
					DATE(2024, 8, 8),
					DATE(2024, 9, 9),
					DATE(2024, 10, 10),
					DATE(2024, 11, 11),
					DATE(2024, 12, 12)},
				"Double Day",
				"Other"
			)
		lineageTag: 3ca62345-2d68-4548-8c87-afefcc9e5d06
		summarizeBy: none


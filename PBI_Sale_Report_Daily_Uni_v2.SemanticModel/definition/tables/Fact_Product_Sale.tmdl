table Fact_Product_Sale
	lineageTag: 32cbc477-413c-4786-a2ca-ecd882dc6e1b

	measure 'Total Qty' = SUM(Fact_Product_Sale[Quantity])
		displayFolder: _Measure Qty
		lineageTag: 0ceba804-ebca-4e61-8c55-83d239438e07

		formatStringDefinition =
				VAR _CurrentValue =
				    SELECTEDMEASURE()
				VAR _NumberFormat =
				    SWITCH (
				        TRUE (),
				        _CurrentValue <= 1E3, "#,0.",
				        --10k 100k
				        _CurrentValue <= 1E4, "#,0,.0K",
				        _CurrentValue <= 1E5, "#,0,.0K",
				        _CurrentValue <= 1E6, "#,0,.K",
				
				        -- 1M
				        _CurrentValue <= 1E7, "#,0,,.0M",
				        _CurrentValue <= 1E8, "#,0,,.0M",
				        _CurrentValue <= 1E9, "#,0,,.M",
				
				        --1B
				        _CurrentValue <= 1E10, "#,0,,,.0B",
				        _CurrentValue <= 1E11, "#,0,,,.0B",
				        _CurrentValue <= 1E12, "#,0,,,.B"
				    )
				VAR _FormatString =
				    _NumberFormat & """" & " Views" & """"
				RETURN
				    _NumberFormat


	measure 'Sales % by Item' =
			// Tính tỷ lệ % sale mỗi Item/product theo Item Name
			Var totalsale = SUM(Fact_Product_Sale[Sales])
			Var totalsaleItem = CALCULATE(SUM(Fact_Product_Sale[Sales]),ALL(Dim_Product[Item Name]))
			Var result = DIVIDE(totalsale,totalsaleItem)
			RETURN
			result
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _Measure Sales
		lineageTag: cbfc125d-1251-4485-a0b4-f3cfcc9d8140

	measure 'Order LY % Adj' =
			
			DIVIDE([Total Order]-[Total Order LY Adj],[Total Order LY Adj])
		formatString: 0%;-0%;0%
		displayFolder: _Measure Order
		lineageTag: 12812753-ec2b-4247-a1ea-b317f3186a92

	measure 'Order MoM%' = DIVIDE([Total Order]-Fact_Product_Sale[Order PM],[Order PM])
		formatString: 0%;-0%;0%
		displayFolder: _Measure Order
		lineageTag: 279847c7-468e-4b39-9a32-68bb1bd30335

	measure 'Order WoW%' =
			
			//% Sale so với tuần trước

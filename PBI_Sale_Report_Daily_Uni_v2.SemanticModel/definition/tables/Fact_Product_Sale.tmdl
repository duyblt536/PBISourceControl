	measure 'Total Sales Previous Year' =
			
			//Doanh thu lũy kế (tổng) của năm trước
			CALCULATE([Total Sales],PREVIOUSYEAR(Dim_Date[Date]))
		formatString: 0
		displayFolder: _Measure Sales
		lineageTag: c0ba78c0-6f1c-4cd0-9561-3d18b680a84a

	measure 'Top Product' = RANKX(ALL(Fact_Product_Sale),[Total Sales])
		formatString: 0

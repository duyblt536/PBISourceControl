	measure 'Diff. Between TY & LY' = IF(ISBLANK([Total Sales]),BLANK(), [Total Sales]-[Total Sales LY])
		formatString: 0
		displayFolder: _Measure Sales
		lineageTag: 920a9dd4-7f3f-472f-ab92-a8342f0570b4

	measure 'Total Qty LY Adj' =
			//điều chỉnh so với cột total qty LY, chỉ hiển thị so với thời gian hiện tại, thêm biến Ispast là TRUE
			CALCULATE(
			    [Total Qty]
			    ,SAMEPERIODLASTYEAR(Dim_Date[Date])
			    ,Dim_Date[IsPast] = TRUE()
			    )
		displayFolder: _Measure Qty
		lineageTag: 90e7f264-4621-4c8a-9c36-98df486c2746

		formatStringDefinition =
				VAR _CurrentValue =
				    SELECTEDMEASURE()
				VAR _NumberFormat =
				    SWITCH (
				        TRUE (),
				        _CurrentValue <= 1E3, "#,0.",
				        --10k 100k
				        _CurrentValue <= 1E4, "#,0,.0K",
				        _CurrentValue <= 1E5, "#,0,.0K",
				        _CurrentValue <= 1E6, "#,0,.K",
				
				        -- 1M
				        _CurrentValue <= 1E7, "#,0,,.0M",
				        _CurrentValue <= 1E8, "#,0,,.0M",

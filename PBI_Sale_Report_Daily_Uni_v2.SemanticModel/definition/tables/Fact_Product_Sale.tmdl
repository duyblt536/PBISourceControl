	measure 'Total Order' =
			CALCULATE(DISTINCTCOUNT(Fact_Product_Sale[Order ID])
			                        ,FILTER((Dim_HoaDon),
			                                    AND(NOT(Dim_HoaDon[Trạng thái]="Đã trả")
			                                        ,NOT( Dim_HoaDon[Trạng thái giao hàng]="Đã chuyển hoàn"
			                                                ))))
			//Không tính số lượng đơn theo trạng thái "Đã trả", trạng thái giao hàng "Đã chuyển hoàn"
		displayFolder: _Measure Order
		lineageTag: f82de353-7bce-4b4b-901b-cd2377eed6bb

		formatStringDefinition =
				VAR _CurrentValue =
				    SELECTEDMEASURE()

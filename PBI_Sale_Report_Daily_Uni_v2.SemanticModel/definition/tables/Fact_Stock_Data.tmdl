table Fact_Stock_Data
	lineageTag: 22d3b2c1-7a8e-4fe6-a590-1979c2cf250f

	measure 'Total Stock' = SUM(Fact_Stock_Data[Tồn cuối kì chi tiết])
		lineageTag: eb9f2790-00db-44df-aa1d-75f259e902ee

		formatStringDefinition =
				VAR _CurrentValue =
				    SELECTEDMEASURE()
				VAR _NumberFormat =
				    SWITCH (
				        TRUE (),
				        _CurrentValue <= 1E3, "#,0.",
				        --10k 100k
				        _CurrentValue <= 1E4, "#,0,.0K",
				        _CurrentValue <= 1E5, "#,0,.0K",
				        _CurrentValue <= 1E6, "#,0,.K",
				
				        -- 1M
				        _CurrentValue <= 1E7, "#,0,,.0M",
				        _CurrentValue <= 1E8, "#,0,,.0M",
				        _CurrentValue <= 1E9, "#,0,,.M",
				
				        --1B
				        _CurrentValue <= 1E10, "#,0,,,.0B",
				        _CurrentValue <= 1E11, "#,0,,,.0B",
				        _CurrentValue <= 1E12, "#,0,,,.B"
				    )
				VAR _FormatString =
				    _NumberFormat & """" & " Views" & """"
				RETURN
				    _NumberFormat

	measure DayStock = DIVIDE([Total Stock],[Total Qty])
		formatString: 0.0
		lineageTag: b03896d5-a1d9-43c4-9a41-68e525c158d2

	measure 'Stock Ratio' = DIVIDE([Total Qty 90 days],[Total Stock])
		lineageTag: 780aa849-d0bd-4690-a33b-3d97c052c62d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DayStock LY' =
			
			CALCULATE([DayStock],SAMEPERIODLASTYEAR(Dim_Date[Date]))
		lineageTag: 580b9799-bdfa-4045-8d6d-d9562ed18c27

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Stock LY' =
			
			CALCULATE([Total Stock],SAMEPERIODLASTYEAR(Dim_Date[Date]))
		formatString: 0
		lineageTag: 2f479695-4523-4a5d-9c68-c36cf492ca1d


		lineageTag: 15461977-9721-4e54-9241-40fe3376876a
		summarizeBy: sum
		sourceColumn: Tồn cuối kì chi tiết

		annotation SummarizationSetBy = Automatic

	column 'End of Month'
		dataType: dateTime
		formatString: Long Date
		lineageTag: 6eae5596-72c4-49fc-9633-3173998473de
		summarizeBy: none
		sourceColumn: End of Month

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

